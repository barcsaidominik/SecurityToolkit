<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SecurityToolkit.Cli</RootNamespace>
    <AssemblyName>security-toolkit</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Local/source builds report this; the release workflow overrides it with -p:Version=<tag>. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!--
    Single-file, self-contained publish. Not the default for `dotnet build` or a plain
    `dotnet publish` (those still need a RID); opt in explicitly, e.g.:

      dotnet publish src/SecurityToolkit.Cli -c Release -r win-x64 -p:SelfContained=true
      dotnet publish src/SecurityToolkit.Cli -c Release -r linux-x64 -p:SelfContained=true

    install.bat / install.sh do exactly this.

    PublishSingleFile/SelfContained below only take effect once a RID is specified (RID-neutral
    publish/build is unaffected), so they're safe to leave set unconditionally here.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecurityToolkit.Core\SecurityToolkit.Core.csproj" />
  </ItemGroup>

</Project>
