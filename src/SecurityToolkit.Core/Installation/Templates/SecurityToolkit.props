<Project>
  <PropertyGroup Condition="'$(SecurityToolkitEnabled)' == 'true'">
    <EnableNETAnalyzers Condition="'$(SecurityToolkitAnalyzers)' == 'true'">true</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild Condition="'$(SecurityToolkitAnalyzers)' == 'true'">true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis Condition="'$(SecurityToolkitAnalyzers)' == 'true'">true</RunAnalyzersDuringLiveAnalysis>
    <NuGetAudit Condition="'$(SecurityToolkitAudit)' == 'true'">true</NuGetAudit>
    <NuGetAuditMode Condition="'$(SecurityToolkitAudit)' == 'true'">all</NuGetAuditMode>
    <NuGetAuditLevel Condition="'$(SecurityToolkitAudit)' == 'true'">low</NuGetAuditLevel>
    <WarningsNotAsErrors Condition="'$(SecurityToolkitAudit)' == 'true'">$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
